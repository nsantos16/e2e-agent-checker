{
  "name": "e2e-agent-checker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "node src/login.ts",
    "verify": "node src/verify.ts",
    "app": "node src/app/server.ts",
    "mcp": "node src/mcp-server.ts",
    "setup": "sh scripts/setup.sh",
    "doctor": "node src/doctor.ts",
    "test": "node --test tests/*.test.ts",
    "test:readiness": "playwright test -c tests/readiness.config.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "vite build",
    "dev:ui": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.61.1",
    "effect": "4.0.3",
    "playwright": "1.61.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tokentally": "0.1.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  }
}
