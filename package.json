{
  "name": "e2e-agent-checker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "node src/login.ts",
    "verify": "node src/verify.ts",
    "app": "node src/app/server.ts",
    "mcp": "node src/mcp-server.ts",
    "setup": "sh scripts/setup.sh",
    "doctor": "node src/doctor.ts",
    "test": "node --test tests/*.test.ts",
    "test:readiness": "playwright test -c tests/readiness.config.ts",
    "test:browser": "node tests/app-browser.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && npm run team:check",
    "build": "vite build",
    "dev:ui": "vite --host 127.0.0.1",
    "team:api": "node --env-file-if-exists=.env.team src/team/server/main.ts",
    "team:db": "node --env-file-if-exists=.env.team src/team/server/cli.ts",
    "team:dev": "node --env-file-if-exists=.env.team node_modules/vite/bin/vite.js --config vite.team.config.ts",
    "team:build": "vite build --config vite.team.config.ts",
    "team:check": "tsc -p tsconfig.team.json --noEmit",
    "test:team": "node --test tests/team-*.test.ts",
    "test:team:browser": "node tests/team-browser.ts"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@babel/parser": "8.0.8",
    "@clerk/backend": "3.26.5",
    "@clerk/react": "6.18.4",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.61.1",
    "@tanstack/react-db": "1.0.0-rc.1.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "effect": "4.0.3",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "playwright": "1.61.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svix": "2.9.1",
    "tokentally": "0.1.7",
    "ws": "^8.22.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "8.3.4"
  }
}
